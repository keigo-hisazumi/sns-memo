rules_version = '2';

// sns-memo 用の Firestore ルール（Firebase コンソールの Firestore ▸ ルール に貼る）
// - プロフィール（users/{uid}）は本人だけが読み書きできる
// - メモ（memos）はドキュメントの uid が自分のものだけ読み書きできる。uid の書き換えは断る
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /memos/{memoId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
